{
  "manifest_version": 3,
  "name": "Watchparty (Free Sync + Chat)",
  "version": "1.5.0",
  "description": "Sync play/pause/seek, chat, emoji reactions, and a live viewer list with friends — each of you watches on your own Netflix, Hotstar, or Prime Video account.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://*.hotstar.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Watchparty",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["adapters/netflix-page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["adapters/netflix.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.hotstar.com/*"],
      "js": ["adapters/hotstar.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.primevideo.com/*", "https://*.amazon.com/gp/video/*"],
      "js": ["adapters/primevideo.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
